            "Javascript_1": {
              "run": {
                "script": {
                  "code": "const input = $workflow.input || {};\nconst action = input.action || 'submit_pickup';\nconst supportedActions = ['submit_pickup', 'cancel_pickup', 'asap_pickup'];\nconst correlationId = input.correlation_id || input.contract_id || input.rental_request_id || input.job_id || 'unassigned';\nif (!supportedActions.includes(action)) {\n  return { status: 'rejected', action, correlation_id: correlationId, message: 'Unsupported rental command.' };\n}\nconst pickupRequestId = `PICKUP-${correlationId}-${action}`;\nreturn {\n  status: 'accepted', action, correlation_id: correlationId,\n  rental_request_id: input.rental_request_id || '', contract_id: input.contract_id || '',\n  pickup_request_id: pickupRequestId,\n  message: action === 'cancel_pickup' ? 'Pickup cancellation accepted.' : 'Pickup command accepted for scheduling.'\n};",
                  "language": "javascript",
                  "arguments": "${{ \"$context\": $context, \"$workflow\": $workflow, \"$input\": $input }}"
                }
              },
              "export": {
                "as": "{ ...$context, outputs: { ...$context?.outputs, \"Javascript_1\": $output } }"
              },
              "metadata": {
                "activityType": "JsInvoke",
                "displayName": "Evaluate rental request",
                "fullName": "JsInvoke"
              }
            }
          },
          {
            "QueryRentalContracts": {
