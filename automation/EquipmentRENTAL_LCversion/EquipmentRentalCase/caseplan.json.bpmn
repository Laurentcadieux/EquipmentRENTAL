            <uipath:input name="caseManagerInput" type="json" target="body"><![CDATA[{"caseDeterministicRules":{"case":{"completionConditions":[{"completionConditionType":"StagesCompleted","parameters":{"stageNames":["Return & Close","Active Rental (Monitoring)","Intake & Triage"]},"ruleName":"Equipment returned and required stages complete"}]},"stages":[{"name":"Extension Request","entryConditions":[{"operator":"AND","conditions":[{"entryConditionType":"StagesExited","parameters":{"stageNames":["Return & Close"],"cancelStagesAndTasks":true}},{"entryConditionType":"Expression","parameters":{"expression":"=js:vars.returnIntent == \"Request Extension\"","expressionString":"vars.returnIntent == \"Request Extension\"","cancelStagesAndTasks":true}}],"ruleName":"Start extension request"}],"exitConditions":[],"completionConditions":[{"completionConditionType":"TasksCompleted","parameters":{"taskNames":["Cancel existing pickup request","Update rental extension in Mastermind","Notify procurement & return to Active Rental"]},"ruleName":"Resume active rental"}],"tasks":[{"name":"Cancel existing pickup request","entryConditions":[{"entryConditionType":"StageEntered","parameters":{"stageNames":["Extension Request"]},"ruleName":"Cancel scheduled pickup"}]},{"name":"Update rental extension in Mastermind","entryConditions":[{"entryConditionType":"TasksCompleted","parameters":{"taskNames":["Cancel existing pickup request"]},"ruleName":"Update extension dates"}]},{"name":"Notify procurement & return to Active Rental","entryConditions":[{"entryConditionType":"TasksCompleted","parameters":{"taskNames":["Update rental extension in Mastermind"]},"ruleName":"Notify procurement and resume monitoring"}]}]},{"name":"Immediate Pickup","entryConditions":[{"operator":"AND","conditions":[{"entryConditionType":"StagesExited","parameters":{"stageNames":["Return & Close"],"cancelStagesAndTasks":true}},{"entryConditionType":"Expression","parameters":{"expression":"=js:vars.returnIntent == \"Immediat