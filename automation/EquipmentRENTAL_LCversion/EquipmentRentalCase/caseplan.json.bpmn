e to immediate pickup"},{"operator":"AND","conditions":[{"exitConditionType":"TasksCompleted","parameters":{"taskNames":["Notify branch & confirm return intent"]}},{"exitConditionType":"Expression","parameters":{"expression":"=js:vars.returnIntent == \"Request Extension\"","expressionString":"vars.returnIntent == \"Request Extension\""}}],"ruleName":"Route to extension request"}],"completionConditions":[{"completionConditionType":"TasksCompleted","parameters":{"taskNames":["Notify branch & confirm return intent","Submit pickup request & confirm scheduling","Verify equipment required status in Mastermind","Conduct return inspection & condition check","Close rental job in Mastermind"]},"ruleName":"Rental return complete"}],"tasks":[{"name":"Notify branch & confirm return intent","runOnlyOnce":false,"entryConditions":[{"entryConditionType":"StageEntered","parameters":{"stageNames":["Return & Close"]},"ruleName":"Request return intent"}]},{"name":"Submit pickup request & confirm scheduling","runOnlyOnce":true,"entryConditions":[{"entryConditionType":"TasksCompleted","parameters":{"taskNames":["Notify branch & confirm return intent"]},"ruleName":"Schedule standard pickup"}]},{"name":"Verify equipment required status in Mastermind","runOnlyOnce":true,"entryConditions":[{"entryConditionType":"TasksCompleted","parameters":{"taskNames":["Submit pickup request & confirm scheduling"]},"ruleName":"Verify equipment status"}]},{"name":"Conduct return inspection & condition check","runOnlyOnce":true,"entryConditions":[{"entryConditionType":"TasksCompleted","parameters":{"taskNames":["Verify equipment required status in Mastermind"]},"ruleName":"Inspect returned equipment"}]},{"name":"Close rental job in Mastermind","runOnlyOnce":true,"entryConditions":[{"entryConditionType":"TasksCompleted","parameters":{"taskNames":["Conduct return inspection & condition check"]},"ruleName":"Close returned rental"}]}]},{"name":"Active Rental (Monitoring)","entryConditions":[{"operator":"AND","con