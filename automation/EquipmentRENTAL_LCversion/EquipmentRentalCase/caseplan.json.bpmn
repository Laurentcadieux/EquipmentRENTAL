            </uipath:context>
            <uipath:input name="ItemData" type="json" target="body"><![CDATA[{"SpecificContent":{"event":"UserAdhocTrigger","eventId":"=js:Array.from({ length: 16 }, () => Math.floor(Math.random() * 256).toString(16).padStart(2, '0')).join('')","taskNames":"=js:(vars.adhocTasksMessageEventSubprocessResponse != null && vars.adhocTasksMessageEventSubprocessResponse.taskNames != null) ? vars.adhocTasksMessageEventSubprocessResponse.taskNames : []","email":"=js:(vars.adhocTasksMessageEventSubprocessSenderInfo != null && vars.adhocTasksMessageEventSubprocessSenderInfo.email != null) ? vars.adhocTasksMessageEventSubprocessSenderInfo.email : null","userId":"=js:(vars.adhocTasksMessageEventSubprocessSenderInfo != null && vars.adhocTasksMessageEventSubprocessSenderInfo.userId != null) ? vars.adhocTasksMessageEventSubprocessSenderInfo.userId : null"},"Reference":"=js:\"case-\" + metadata.InstanceId","Error":null,"TimeToLive":null}]]></uipath:input>
