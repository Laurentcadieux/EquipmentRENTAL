            <uipath:input name="caseManagerInput" type="json" target="body"><![CDATA[{"caseRulesDecisions":"=js:(vars.caseRulesDecisions)","caseCurrentExecutionState":"=js:({ \"version\": 1, \"eventIdentifier\": vars.EventSubProcessEventIdentifier, \"event\": { \"type\": vars.EventSubProcessLatestEventType, \"parameters\": vars.EventSubProcessLatestEventParams, \"isExternal\": (vars.EventSubProcessLatestEventType == \"TaskCompleted\" || vars.EventSubProcessLatestEventType == \"SlaStatusChange\") ? false : true }, \"state\": { ...vars.caseState, \"vars\": { \"Cancel existing pickup request\": {  }, \"Update rental extension in Mastermind\": {  }, \"Notify procurement & return to Active Rental\": {  }, \"Notify United Rentals for ASAP pickup\": {  }, \"Update job status\": {  }, \"Notify branch & confirm return intent\": {  }, \"Submit pickup request & confirm scheduling\": {  }, \"Verify equipment required status in Mastermind\": {  }, \"Conduct return inspection & condition check\": {  }, \"Close rental job in Mastermind\": {  }, \"Monitor rental contract end date\": {  }, \"Send staged expiry alerts\": {  }, \"Validate job & rental data\": {  }, \"Classify order status & route case\": {  }, \"Received event params\": { \"response\": (vars.mainEventSubprocessResponse.connectorResponse) }, \"APIEvent\": (vars.mainEventSubprocessResponse.apiEvent), \"metadata\": { \"FolderKey\": (metadata.FolderKey), \"ProcessKey\": (metadata.ProcessKey), \"InstanceId\": (metadata.InstanceId), \"ExternalId\": (metadata.ExternalId) } } } })"}]]></uipath:input>
