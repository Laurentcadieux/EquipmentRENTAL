ck\": {  }, \"Close rental job in Mastermind\": {  }, \"Monitor rental contract end date\": {  }, \"Send staged expiry alerts\": {  }, \"Validate job & rental data\": {  }, \"Classify order status & route case\": {  }, \"Received event params\": { \"response\": (vars.mainEventSubprocessResponse.connectorResponse) }, \"APIEvent\": (vars.mainEventSubprocessResponse.apiEvent), \"metadata\": { \"FolderKey\": (metadata.FolderKey), \"ProcessKey\": (metadata.ProcessKey), \"InstanceId\": (metadata.InstanceId), \"ExternalId\": (metadata.ExternalId) } } } })"}]]></uipath:input>
