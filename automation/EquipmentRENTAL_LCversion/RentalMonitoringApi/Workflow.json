  "do": [
    {
      "Sequence_1": {
        "do": [
          {
            "WorkflowStart": {
              "set": "${Object.entries($workflow.definition?.document?.metadata?.variables?.schema?.document?.properties || {}).reduce((acc, [name, def]) => ({ ...acc, [name]: def?.default }), {}) }",
              "output": {
                "as": "${$input}"
              },
              "export": {
                "as": "{ ...$context, variables: { ...$context.variables, ...$output } }"
              },
              "metadata": {
                "activityType": "Assign",
                "displayName": "Workflow start",
                "fullName": "Assign",
                "isTransparent": true
              }
            }
          },
          {
            "Javascript_1": {
              "run": {
                "script": {
                  "code": "const input = $workflow.input || {};\nconst days = Number.isFinite(Number(input.days_remaining)) ? Number(input.days_remaining) : null;\nconst correlationId = input.correlation_id || input.contract_id || 'unassigned';\nif (days === null) return { status: 'needs_input', alert_stage: 'none', days_remaining: 0, correlation_id: correlationId, message: 'days_remaining is required for monitoring.' };\nconst alertStage = days <= 1 ? '1-day' : days <= 7 ? '7-day' : days <= 30 ? '30-day' : 'none';\nreturn { status: days < 0 ? 'expired' : 'monitored', alert_stage: alertStage, days_remaining: days, correlation_id: correlationId, message: alertStage === 'none' ? 'No staged alert is due.' : `Rental expiry ${alertStage} alert is due.` };",
                  "language": "javascript",
                  "arguments": "${{ \"$context\": $context, \"$workflow\": $workflow, \"$input\": $input }}"
                }
              },
              "export": {
                "as": "{ ...$context, outputs: { ...$context?.outputs, \"Javascript_1\": $output } }"
              },
              "metadata": {
                "activityType": "JsInvoke",
                "displayName": "Evaluate rental request",
                "fullName": "JsInvoke"
              }
            }
          },
          {
            "QueryRentalContracts": {
              "call": "UiPath.IntSvc",
              "with": {
                "connector": "uipath-uipath-dataservice",
                "connectionId": "5799c39b-43b3-42e0-8860-c23cf05d681d",
                "connectionResourceId": "5799c39b-43b3-42e0-8860-c23cf05d681d",
                "method": "POST",
                "endpoint": "/v2/{entityName}/qer",
                "queryParameters": {
                  "queryExpression": "${$workflow.input.contract_id ? `ContractId = '${$workflow.input.contract_id}'` : ''}",
                  "limit": 1,
                  "expansionLevel": 1
                },
                "pathParameters": {
                  "entityName": "Rental_Contracts"
                },
                "bodyParameters": {}
              },
              "export": {
                "as": "{ ...$context, outputs: { ...$context?.outputs, \"QueryEntityRecordsCurated_1\": $output } }"
              },
              "metadata": {
                "fullName": "Connector",
                "activityType": "Connector",
                "displayName": "Read rental contract",
                "uiPathActivityTypeId": "703065b9-a310-33b8-9d4d-12df0a6f520b",
                "assemblyQualifiedName": "Connector",
                "configuration": "{\"essentialConfiguration\":{\"connectorVersion\":\"\",\"executionType\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"version\":\"1.0.0\",\"connectorKey\":\"uipath-uipath-dataservice\",\"activityType\":\"Curated\",\"objectName\":\"QueryEntityRecordsCurated\",\"httpMethod\":\"POST\",\"operation\":null,\"eventOperation\":null,\"eventMode\":null,\"connectorObjects\":null,\"previewEndpoint\":null},\"objectName\":\"QueryEntityRecordsCurated\",\"operation\":null,\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/v2/{entityName}/qer\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_QueryEntityRecordsCurated\"}}"
              }
            }
          },
          {
            "CreateMonitoringFlag": {
              "call": "UiPath.IntSvc",
              "with": {
                "connector": "uipath-uipath-dataservice",
                "connectionId": "5799c39b-43b3-42e0-8860-c23cf05d681d",
                "connectionResourceId": "5799c39b-43b3-42e0-8860-c23cf05d681d",
                "method": "POST",
                "endpoint": "/v2/{entityName}/CreateEntityRecord",
                "queryParameters": {
                  "expansionLevel": 1
                },
                "pathParameters": {
                  "entityName": "Rental_Monitoring_Flags"
                },
                "bodyParameters": {
                  "FlagId": "${`MON-${$workflow.input.correlation_id || $workflow.input.contract_id || Date.now()}`}",
                  "FlagType": "RentalExpiry",
                  "FlagDate": "${new Date().toISOString().slice(0, 10)}",
                  "TargetDate": "${$workflow.input.rental_end_date || ''}",
                  "DaysBeforeEnd": "${Number($workflow.input.days_remaining || 0)}",
                  "Severity": "${Number($workflow.input.days_remaining || 0) <= 1 ? 'Critical' : Number($workflow.input.days_remaining || 0) <= 7 ? 'High' : 'Normal'}",
                  "Status": "Open",
                  "ResolutionNotes": "${`Monitoring check recorded for ${$workflow.input.contract_id || 'unassigned'}.`}",
                  "AlertWindow": "${Number($workflow.input.days_remaining || 0)}",
                  "CreatedAt": "${new Date().toISOString()}",
                  "CorrelationId": "${$workflow.input.correlation_id || $workflow.input.contract_id || 'unassigned'}"
                }
              },
              "export": {
                "as": "{ ...$context, outputs: { ...$context?.outputs, \"CreateEntityRecordCurated_1\": $output } }"
              },
              "metadata": {
                "fullName": "Connector",
                "activityType": "Connector",
                "displayName": "Write monitoring flag",
                "uiPathActivityTypeId": "dfd2bc7a-ca4b-3316-8a1f-57c9e106dfbf",
                "assemblyQualifiedName": "Connector",
                "configuration": "{\"essentialConfiguration\":{\"connectorVersion\":\"\",\"executionType\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"version\":\"1.0.0\",\"connectorKey\":\"uipath-uipath-dataservice\",\"activityType\":\"Curated\",\"objectName\":\"CreateEntityRecordCurated\",\"httpMethod\":\"POST\",\"operation\":null,\"eventOperation\":null,\"eventMode\":null,\"connectorObjects\":null,\"previewEndpoint\":null},\"objectName\":\"CreateEntityRecordCurated\",\"operation\":null,\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/v2/{entityName}/CreateEntityRecord\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_CreateEntityRecordCurated\"}}"
              }
            }
          },
          {
            "Response_1": {
              "response": "${$context.outputs.Javascript_1}",
              "markJobAsFailed": false,
              "then": "end",
              "export": {
                "as": "{ ...$context, outputs: { ...$context?.outputs, \"Response_1\": $output } }"
              },
              "metadata": {
                "activityType": "Response",
                "displayName": "Return result",
                "fullName": "Response"
              }
            }
          }
        ],
        "metadata": {
          "activityType": "Sequence",
          "displayName": "Sequence",
          "fullName": "Sequence"
        }
